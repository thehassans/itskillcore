# Production Environment Variables for Railway / Render
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lms?retryWrites=true&w=majority
JWT_SECRET=replace-with-64-char-random-hex-secret
SEED_KEY=replace-with-strong-random-seed-key
NEXT_PUBLIC_URL=https://your-app-domain.com
NODE_ENV=production
